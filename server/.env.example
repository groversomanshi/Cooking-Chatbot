# Aiven Postgres connection string. Include sslmode=require if it is not
# already present in the URL Aiven gives you.
DATABASE_URL=postgres://avnadmin:password@host.aivencloud.com:12345/defaultdb?sslmode=require

# Optional. Path to the fine-tuned CLIP checkpoint. If unset, the server
# searches: ./clip_finetuned_production_final.pth, ../my-app/...,
# and ../clip_finetuned_production_final.pth.
# CLIP_WEIGHTS_PATH=

# Cosine-similarity threshold below which we report "not detected".
CLIP_CONFIDENCE_THRESHOLD=0.2

# Server port (must match NEXT_PUBLIC_DETECT_URL in my-app/.env.local).
PORT=5000

