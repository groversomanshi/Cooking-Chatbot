# Supabase. The publishable key is fine if RLS allows anon SELECT on
# public.ingredients. Otherwise use the service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_or_service_role_key

# Optional. Path to the fine-tuned CLIP checkpoint. If unset, the server
# searches: ./clip_finetuned_production_final.pth, ../my-app/...,
# and ../clip_finetuned_production_final.pth.
# CLIP_WEIGHTS_PATH=

# Cosine-similarity threshold below which we report "not detected".
CLIP_CONFIDENCE_THRESHOLD=0.2

# Server port (must match NEXT_PUBLIC_DETECT_URL in my-app/.env.local).
PORT=5000

# NOTE: No DATABASE_URL needed. The recommender runs inside Supabase Postgres via
# RPC functions (see server/sql/recommender.sql).
